{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $pages = first 10 $pages -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title | htmlEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | htmlEscape }}</description>
    <atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml" />
    <generator>Hugo</generator>
    {{ range $pages }}
    <item>
      <title>{{ .Title | htmlEscape }}</title>
      <description>{{ .Content | htmlEscape }}</description>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{ range .Params.tags }}<category>{{ . | htmlEscape }}</category>{{ end }}
      {{ range .Params.categories }}<category>{{ . | htmlEscape }}</category>{{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
